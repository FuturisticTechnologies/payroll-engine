# ---------------------------------------------------------------------------
# Backend-only environment template (used when running natively, outside
# docker compose). The root-level .env.example is used by docker compose.
# ---------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-this-must-be-at-least-32-chars
APP_CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
LOCAL_ADMIN_EMAIL=admin@payrollfuturistic.co.uk
LOCAL_ADMIN_PASSWORD=Admin12345!

DATABASE_URL=postgresql+asyncpg://payroll:payroll_dev_pwd@localhost:5432/payroll
DATABASE_URL_SYNC=postgresql+psycopg2://payroll:payroll_dev_pwd@localhost:5432/payroll
REDIS_URL=redis://localhost:6379/0

JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

HMRC_BASE_URL=https://test-api.service.hmrc.gov.uk
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=
